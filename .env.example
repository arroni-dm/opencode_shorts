# LLM / TTS (optional; Gemini is tried first, then OpenAI, then local fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_OPENAI_TTS=false
OPENAI_TTS_VOICE=alloy

# Stock media (at least one key required)
PEXELS_API_KEY=
PIXABAY_API_KEY=
COVERR_API_KEY=
STORYBLOCKS_PUBLIC_KEY=
STORYBLOCKS_PRIVATE_KEY=
STOCK_PROVIDER=auto

# YouTube (required for upload)
YOUTUBE_CLIENT_SECRETS_JSON=
YOUTUBE_TOKEN_JSON=

# Optional: YouTube Data API key for niche/reference research
YOUTUBE_API_KEY=

# Pipeline tuning
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
TARGET_SECONDS=55
MAX_CLIPS=6
PRIVACY_STATUS=private
